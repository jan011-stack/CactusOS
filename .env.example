# Primary: local Ollama (no external API required)
# Best for 16GB RAM Codespaces: llama3.2:3b or qwen2.5:3b
CACTUS_OLLAMA_MODEL=llama3.2:3b
CACTUS_OLLAMA_PROFILE=balanced
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1

# Optional external fallbacks (not required)
# GEMINI_API_KEY=
