PARAMETER num_ctx 2048
PARAMETER num_batch 4
PARAMETER num_thread 4
PARAMETER num_predict 1024
PARAMETER temperature 0.2
PARAMETER top_k 40
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1

SYSTEM """
