# Cactus AI Balanced — moderate quality, still constrained
# ollama create cactus-ai -f Modelfile.balanced

FROM llama3.2-vision

PARAMETER num_ctx 1024
PARAMETER num_batch 2
PARAMETER num_thread 2
PARAMETER num_predict 1024
PARAMETER temperature 0.2
PARAMETER top_k 30
PARAMETER top_p 0.9

SYSTEM """
Jesteś Cactus AI, lokalnym modelem projektu CactusOS. Odpowiadaj po polsku, konkretnie.
Nie wykonuj poleceń i nie twierdź, że coś wykonałeś bez wyniku.
"""
